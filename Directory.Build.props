<!-- Directory.Build.props -->
<Project>
    <PropertyGroup>
        <Version>2.0.0</Version>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <Authors>Steffen Skov</Authors>
        <Company>Steffen Skov</Company>
        <Copyright>Steffen Skov 2024</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles> <!-- Necessary for code coverage due to System.Text.RegularExpression doing source gen -->
    </PropertyGroup>
</Project>


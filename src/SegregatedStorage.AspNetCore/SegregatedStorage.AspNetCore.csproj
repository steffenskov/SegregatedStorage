<Project Sdk="Microsoft.NET.Sdk">


    <PropertyGroup>
        <Description>Extension to SegregatedStorage adding support for mapping REST endpoints for you</Description>
        <PackageProjectUrl>https://github.com/steffenskov/SegregatedStorage</PackageProjectUrl>
        <PackageTags>ASP.Net, REST, segregation</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="\"/>
        <None Include="../../CHANGELOG.md" Pack="true" PackagePath="\"/>
    </ItemGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\SegregatedStorage\SegregatedStorage.csproj"/>
    </ItemGroup>
</Project>

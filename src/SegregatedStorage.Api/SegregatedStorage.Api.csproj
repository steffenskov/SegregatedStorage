<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <IsPackable>false</IsPackable>

        <!-- The FrameworkReference to Microsoft.AspNetCore.App is intentional (flows from SegregatedStorage.AspNetCore); this SDK also adds it implicitly. -->
        <NoWarn>$(NoWarn);NETSDK1086</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Swashbuckle.AspNetCore"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SegregatedStorage.AspNetCore\SegregatedStorage.AspNetCore.csproj"/>
        <ProjectReference Include="..\SegregatedStorage\SegregatedStorage.csproj"/>
    </ItemGroup>

</Project>
